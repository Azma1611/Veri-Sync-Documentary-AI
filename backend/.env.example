# VeriSync AI Engine Configuration
PROJECT_NAME="VeriSync AI - Document Verification Engine"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ACTIVE_DOMAIN="employment-hr"
LOG_LEVEL="INFO"
 
# AI / LLM Configuration (Optional, provider-independent)
# Set LLM_ENABLED=true and provide an API key to enable AI assistance
LLM_ENABLED=false
LLM_PROVIDER="openai" # "openai" (OpenAI/Groq/Ollama/vLLM), "mock", "none"
LLM_API_KEY="" # e.g. "sk-..." - NEVER commit real keys
LLM_API_BASE="https://api.openai.com/v1" # or custom endpoint e.g. http://localhost:11434/v1
LLM_MODEL="gpt-4o-mini"
LLM_TIMEOUT_SECONDS=12.0
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0
LLM_REDACT_PII=true
